{
  "name": "contextgym",
  "version": "0.9.0",
  "description": "Experiment-driven context optimization for coding agents.",
  "type": "module",
  "bin": {
    "contextgym": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "codex",
    "agents-md",
    "context-engineering",
    "context-optimization",
    "benchmark",
    "developer-tools"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "examples",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  }
}
